<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI%20Toolkit/Terminal/TerminalStyle.uss?fileID=7433441132597879392&amp;guid=955a0bfd08a05d94e93b69d4cc59b850&amp;type=3#TerminalStyle" />
    <ui:VisualElement name="Main" picking-mode="Ignore" class="fill" style="flex-grow: 1; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-left: 52px; padding-top: 32px; padding-bottom: 32px; padding-right: 52px; align-items: center; position: relative; top: 0; right: 0; height: 1080px; width: 1920px; left: 0; align-self: center; flex-direction: row; justify-content: center;">
        <ui:VisualElement name="VisibleArea" picking-mode="Ignore" class="fill" style="flex-grow: 1; align-items: center; position: relative; top: 0; right: 0; height: 100%; width: 100%; left: 0; align-self: center; flex-direction: row; justify-content: center; background-color: rgba(255, 0, 184, 0);">
            <ui:VisualElement name="LeftColumn" style="width: 27.5%; height: 100%; align-self: center; justify-content: space-around;">
                <ui:VisualElement name="ShellMenu" class="border" style="width: 435px; height: 425px; align-items: auto; justify-content: space-around; align-self: center; position: relative; -unity-background-scale-mode: scale-to-fit;" />
            </ui:VisualElement>
            <ui:VisualElement name="MiddleColumn" style="align-self: stretch; justify-content: center; align-items: center; flex-direction: column; max-width: initial; width: 45%; height: 100%;">
                <ui:VisualElement name="Map">
                    <ui:VisualElement name="MapStats" style="flex-direction: column; align-items: auto; position: absolute; top: -7%; width: 100%;">
                        <ui:Label tabindex="-1" text="100 m to target" parse-escape-sequences="true" display-tooltip-when-elided="true" name="distance" class="text mapText" style="width: 369px; position: relative; top: 0; left: 0; -unity-text-align: middle-right; -unity-font: url(&quot;project://database/Assets/Fonts/modern-proggy-tiny/ProggyTiny.ttf?fileID=12800000&amp;guid=33f1463ca56a5f2469e4ee94d71b5478&amp;type=3#ProggyTiny&quot;); letter-spacing: -2px; word-spacing: -23px; font-size: 30px; white-space: nowrap;" />
                        <ui:Label tabindex="-1" text="45° heading advised" parse-escape-sequences="true" display-tooltip-when-elided="true" name="angle" class="text mapText" style="width: 417px; position: relative; top: 0; left: 0; -unity-text-align: middle-right; word-spacing: -23px; letter-spacing: -2px; font-size: 30px;" />
                    </ui:VisualElement>
                    <ui:VisualElement name="TopoMap" focusable="false" class="border" style="flex-grow: 1; width: 764px; height: 764px; position: relative; -unity-background-scale-mode: scale-to-fit; rotate: 0; overflow: hidden; justify-content: flex-end; align-items: auto; align-self: flex-end;">
                        <ui:VisualElement name="zoneLayer" style="flex-grow: 1; position: absolute; left: 0; top: 0;">
                            <ui:VisualElement name="targetPoint" class="zone zoneTarget" style="background-image: url(&quot;project://database/Assets/Images/Circle.png?fileID=2800000&amp;guid=eb6cfdcde7783e34fa68addc9136fcfb&amp;type=3#Circle&quot;); top: 409px; left: 184px; width: 99px; height: 99px;">
                                <ui:Label tabindex="-1" text="A" parse-escape-sequences="true" display-tooltip-when-elided="true" name="targetLabel" class="pointLabel" />
                            </ui:VisualElement>
                            <ui:VisualElement name="extractPoint" class="zone zoneExtract" style="top: 411px; left: 375px; width: 99px; height: 99px;">
                                <ui:VisualElement name="extractIcon" style="flex-grow: 1; position: absolute; background-image: url(&quot;project://database/Assets/Images/ExitIcon/Exit.png?fileID=2800000&amp;guid=3fd2e2ffdb311de49b59254ec48c1a95&amp;type=3#Exit&quot;); width: 45px; height: 45px;" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement name="shellIcon" style="flex-grow: 1; position: absolute; height: 10px; width: 10px; top: 257px; left: 269px; background-image: url(&quot;project://database/Assets/Images/Circle.png?fileID=2800000&amp;guid=eb6cfdcde7783e34fa68addc9136fcfb&amp;type=3#Circle&quot;); -unity-background-image-tint-color: rgb(217, 0, 0); align-items: center; justify-content: center; align-self: center;" />
                        <ui:VisualElement name="playerIcon" style="flex-grow: 1; background-image: url(&quot;project://database/Assets/Images/playerIcon.png?fileID=21300000&amp;guid=f486550e4bfddc04f8ecfc23fb4628f0&amp;type=3#playerIcon&quot;); -unity-background-image-tint-color: rgb(217, 0, 0); background-color: rgba(255, 255, 255, 0); position: absolute; width: 30px; height: 30px; top: 313px; left: 342px; -unity-background-scale-mode: scale-to-fit; border-left-color: rgba(255, 255, 255, 0); border-right-color: rgba(255, 255, 255, 0); border-top-color: rgba(255, 255, 255, 0); border-bottom-color: rgba(255, 255, 255, 0); border-top-width: 2px; border-right-width: 2px; border-bottom-width: 2px; border-left-width: 2px;" />
                        <ui:VisualElement name="shellPath" picking-mode="Ignore" style="flex-grow: 1; background-color: rgb(255, 0, 198); position: absolute; width: 42px; height: 4px; top: 373px; left: 312px; -unity-background-scale-mode: stretch-to-fill; transform-origin: left; display: none; visibility: hidden;" />
                        <ui:VisualElement name="cursorPoint" style="flex-grow: 1; background-image: url(&quot;project://database/Assets/Images/Cross.png?fileID=2800000&amp;guid=f3fd16405f1eac948b7427dbda0552d9&amp;type=3#Cross&quot;); -unity-background-image-tint-color: rgb(255, 255, 255); background-color: rgba(255, 255, 255, 0); position: absolute; width: 20px; height: 20px; top: 339px; left: 377px; -unity-background-scale-mode: scale-to-fit;" />
                    </ui:VisualElement>
                    <ui:VisualElement name="MortarStats" style="flex-direction: row; align-items: auto; position: absolute; top: 101%; width: 100%;">
                        <ui:VisualElement name="StatBox" style="width: 21%;">
                            <ui:Label tabindex="-1" text="ANGL:" parse-escape-sequences="true" display-tooltip-when-elided="true" name="firingAngle" class="text mapText" style="color: rgb(255, 255, 255); margin-left: 0;" />
                            <ui:Label tabindex="-1" text="HEAD:" parse-escape-sequences="true" display-tooltip-when-elided="true" name="mortarRotation" class="text mapText" style="color: rgb(255, 255, 255); white-space: nowrap; margin-left: 0;" />
                        </ui:VisualElement>
                        <ui:VisualElement name="StatBox" style="width: 50%;">
                            <ui:Label tabindex="-1" text="HGHT:" parse-escape-sequences="true" display-tooltip-when-elided="true" name="shellHeight" class="text mapText" style="color: rgb(255, 255, 255); margin-left: 0;" />
                            <ui:Label tabindex="-1" text="DIST:" parse-escape-sequences="true" display-tooltip-when-elided="true" name="shellDistance" class="text mapText" style="color: rgb(255, 255, 255); text-overflow: ellipsis; margin-left: 0;" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="RightColumn" style="width: 27.5%; height: 100%; align-self: center; flex-direction: column; align-items: center; justify-content: space-between; padding-top: 126px; padding-bottom: 126px;">
                <ui:VisualElement name="MortarCam" class="border" style="background-image: url(&quot;project://database/Assets/Visuals/TrailCamRenderTexture.renderTexture?fileID=8400000&amp;guid=f79daf8bb760cc34b8a9401b9d0eefc2&amp;type=2#TrailCamRenderTexture&quot;); width: 358px; height: 280px; align-items: auto; justify-content: space-around; align-self: center; position: relative; -unity-background-scale-mode: scale-to-fit;" />
                <ui:VisualElement name="RangeTable" class="border" style="position: relative; flex-direction: row; height: 366px; width: 358px; padding-left: 10px; padding-right: 10px; background-color: rgb(7, 7, 7); align-self: center; justify-content: center;">
                    <ui:VisualElement name="AngleColumn" class="tableCollumn" style="flex-grow: 1; height: 305px; align-items: center;">
                        <ui:Label tabindex="-1" text="ANGLE" parse-escape-sequences="true" display-tooltip-when-elided="true" name="AngleLabel" class="subHeader tableHeader" style="align-items: center;" />
                        <ui:Label tabindex="-1" text="30&#10;40&#10;45&#10;50&#10;60&#10;70&#10;80" parse-escape-sequences="true" display-tooltip-when-elided="true" name="AngleData" class="text data tableData" style="color: rgb(255, 255, 255); -unity-text-align: upper-center; align-items: center;" />
                    </ui:VisualElement>
                    <ui:VisualElement name="RangeColumn" class="tableCollumn" style="flex-grow: 1; flex-direction: column; align-items: center; height: 303px;">
                        <ui:Label tabindex="-1" text="RANGE" parse-escape-sequences="true" display-tooltip-when-elided="true" name="RangeLabel" class="subHeader tableHeader" style="align-items: center;" />
                        <ui:Label tabindex="-1" text="XXXX&#10;XXXX&#10;XXXX&#10;XXX&#10;XXX&#10;XXX&#10;XXX&#10;" parse-escape-sequences="true" display-tooltip-when-elided="true" name="RangeData" class="text data tableData" style="color: rgb(255, 255, 255); -unity-text-align: upper-center; align-items: center;" />
                    </ui:VisualElement>
