            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
    <ui:VisualElement name="Anchor" style="flex-grow: 1; position: absolute; left: 0; top: 0; width: 1920px; height: 1080px; display: none;">
        <ui:VisualElement name="TerminalHeader" style="flex-grow: 1; position: absolute; top: 57px; left: 50px; display: none;">
            <ui:Label tabindex="-1" text="BLL&lt;sup&gt;®&lt;/sup&gt; REMOTE KINETIC DELIVERY SYSTEM" parse-escape-sequences="true" display-tooltip-when-elided="true" name="Header" class="header" style="color: rgb(255, 255, 255); margin-bottom: -10px; margin-top: -16px; margin-right: 4px; margin-left: -5px; -unity-font: url(&quot;project://database/Assets/Fonts/modern-fixedsys-excelsior/FSEX301-L2.ttf?fileID=12800000&amp;guid=9e46e9631190cb3408ae7d0198e3cd09&amp;type=3#FSEX301-L2&quot;); font-size: 64px; width: 1681px;" />
            <ui:Label tabindex="-1" text="CONNECTED TO: MODEL C1UB (CLASS I UPLINK BALLISTA)" parse-escape-sequences="true" display-tooltip-when-elided="true" name="Subheader" class="text header" style="color: rgb(255, 255, 255); font-size: 40px; -unity-font-style: normal; -unity-font: url(&quot;project://database/Assets/Fonts/modern-fixedsys-excelsior/FSEX301-L2.ttf?fileID=12800000&amp;guid=9e46e9631190cb3408ae7d0198e3cd09&amp;type=3#FSEX301-L2&quot;); margin-top: -7px; margin-bottom: -7px; margin-left: -4px;" />
        </ui:VisualElement>
        <ui:VisualElement name="PackageData" style="flex-grow: 1; position: absolute; top: 135px; left: 592px; width: 352px; display: flex;">
            <ui:Label tabindex="-1" text="PACKAGE STATUS" parse-escape-sequences="true" display-tooltip-when-elided="true" name="Objectives" class="text data" style="color: rgb(255, 255, 255); font-size: 50px; -unity-font-style: normal; -unity-font: url(&quot;project://database/Assets/Fonts/modern-fixedsys-excelsior/FSEX301-L2.ttf?fileID=12800000&amp;guid=9e46e9631190cb3408ae7d0198e3cd09&amp;type=3#FSEX301-L2&quot;); margin-bottom: 16px; margin-top: 16px; margin-left: 0; padding-left: 0; -unity-text-align: upper-left;" />
            <ui:Label tabindex="-1" text="PKG 1: DELIVERED&#10;PKG 2: IN TRANSIT&#10;PKG 3: IN TRANSIT&#10;PKG 4: DELIVERED&#10;PKG 5: PKG LOST" parse-escape-sequences="true" display-tooltip-when-elided="true" name="objList" class="text data" style="color: rgb(255, 255, 255); width: 365px; margin-left: -3px; -unity-paragraph-spacing: 72px; padding-left: 7px;" />
        </ui:VisualElement>
        <ui:VisualElement name="LEGALESE" style="flex-grow: 1; height: 42px; width: 1731px; position: absolute; top: 948px; left: 50px; -unity-text-align: upper-right; align-items: flex-start; transform-origin: center; align-self: stretch; display: none;">
            <ui:Label tabindex="-1" text="THIS TERMINAL IS PROPERTY OF BALLISTA LONGSHOT LOGISTICS&lt;sup&gt;®&lt;/sup&gt;. UNAUTHORIZED ACCESS BY NON BLL&lt;sup&gt;®&lt;/sup&gt; EMPLOYEES OR MISUSE BY DESIGNATED OPERATORS IS PROHIBITED." parse-escape-sequences="true" display-tooltip-when-elided="true" name="legalese" class="legalese text" style="font-size: 22px; -unity-text-align: upper-left; margin-bottom: -2px; width: 1753px; padding-bottom: 6px; -unity-font-style: normal; -unity-font: url(&quot;project://database/Assets/Fonts/modern-fixedsys-excelsior/FSEX301-L2.ttf?fileID=12800000&amp;guid=9e46e9631190cb3408ae7d0198e3cd09&amp;type=3#FSEX301-L2&quot;); transform-origin: center;" />
            <ui:Label tabindex="-1" text="VIOLATERS MAY BE SUBJECT TO LIFESPAN FORFEITURE OF 20 OR MORE YEARS TO BLL&lt;sup&gt;®&lt;/sup&gt; AND ITS SUBSIDIARIES. IN THE EVENT OF DEATH BEFORE FULFILLMENT, LIFESPAN DEBT WILL BE PASSED ON TO NEXT OF KIN, SIGNIFICANT OTHER, OR OTHER LEGAL SUCCESSOR. IN THE EVENT THAT NO SUCCESSOR CAN BE FOUND, VIOLATORS MAY BE SUBJECT TO AI VIRTUALIZATION AND WILL BE UNDER PERMANENT BLL&lt;sup&gt;®&lt;/sup&gt; OWNERSHIP. MISUSE INCLUDES, BUT IS NOT LIMITED TO, INTENTIONAL SABOTAGE, UNINTENTIONAL DAMAGE, UNAUTHORIZED ACCESS TO ENTERTAINMENT MEDIA, UNAUTHORIZED PREMATURE TERMINATION OF CONTRACT, AND THEFT OF COMMUNICATION HOURS (BOTH GENERAL AND FAMILIAL)." parse-escape-sequences="true" display-tooltip-when-elided="true" name="legaleseContract" class="legalese text" style="-unity-text-align: upper-left; font-size: 20px; width: 1753px; -unity-paragraph-spacing: 28px; -unity-font-style: normal; white-space: normal; height: 53px;" />
        </ui:VisualElement>
    </ui:VisualElement>
    <ui:VisualElement name="Frame" picking-mode="Ignore" focusable="false" style="background-image: url(&quot;project://database/Assets/Images/terminalFrame.png?fileID=2800000&amp;guid=248af471392678547a7c421f51db88e0&amp;type=3#terminalFrame&quot;); flex-direction: row; height: 1080px; width: 1920px; position: absolute; display: none; visibility: hidden;" />
